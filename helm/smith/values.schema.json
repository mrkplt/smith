{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "string",
          "enum": ["local", "staging", "stage", "prod"]
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["name"]
          }
        },
        "featureFlags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "loopPolicyConfig": { "type": "boolean" },
            "operatorOverrides": { "type": "boolean" },
            "auditStream": { "type": "boolean" },
            "interactiveAttach": { "type": "boolean" }
          }
        },
        "rolloutId": {
          "type": ["string", "number"]
        }
      },
      "required": ["environment", "imagePullSecrets", "featureFlags"]
    },
    "etcd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https?://"
          },
          "minItems": 1
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "caSecretName": { "type": "string" },
            "certSecretName": { "type": "string" }
          },
          "required": ["enabled", "caSecretName", "certSecretName"]
        }
      },
      "required": ["endpoints", "tls"]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "create": { "type": "boolean" },
        "claudeMaxEnabled": { "type": "boolean" },
        "managed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gitPat": { "type": "string" },
            "runtimeCredentials": { "type": "string" },
            "runtimeCredentialsClaude": { "type": "string" },
            "runtimeCredentialsClaudeMaxCredentialsJson": { "type": "string" },
            "runtimeCredentialsClaudeMaxClaudeJson": { "type": "string" },
            "runtimeCredentialsClaudeMaxSettingsJson": { "type": "string" }
          },
          "required": ["gitPat", "runtimeCredentials"]
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gitPat": { "type": "string", "minLength": 1 },
            "runtimeCredentials": { "type": "string", "minLength": 1 },
            "runtimeCredentialsClaude": { "type": "string", "minLength": 1 },
            "claudeMaxCredentialsJson": { "type": "string", "minLength": 1 },
            "claudeMaxClaudeJson": { "type": "string", "minLength": 1 },
            "claudeMaxSettingsJson": { "type": "string", "minLength": 1 }
          },
          "required": ["gitPat", "runtimeCredentials"]
        }
      },
      "required": ["existingSecret", "create", "managed", "keys"],
      "allOf": [
        {
          "if": {
            "properties": {
              "create": { "const": true }
            },
            "required": ["create"]
          },
          "then": {
            "properties": {
              "existingSecret": { "maxLength": 0 }
            }
          }
        }
      ]
    },
    "core": { "$ref": "#/definitions/componentConfigWithLoopPolicy" },
    "api": { "$ref": "#/definitions/componentConfigWithService" },
    "documentDependencies": { "$ref": "#/definitions/documentDependenciesConfig" },
    "console": { "$ref": "#/definitions/componentConfigWithService" },
    "chat": { "$ref": "#/definitions/componentConfigWithService" },
    "daemon": { "$ref": "#/definitions/daemonConfig" },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" }
      },
      "required": ["create"]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      },
      "required": ["enabled"]
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  },
  "required": ["global", "etcd", "secrets", "core", "api", "console", "chat", "daemon", "rbac", "ingress", "nameOverride", "fullnameOverride"],
  "definitions": {
    "componentImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "optionalComponentImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      },
      "required": ["create", "name"]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": ["type", "port"]
    },
    "envVar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      },
      "required": ["name", "value"]
    },
    "gooseConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "apiKeyFromRuntimeSecret": { "type": "boolean" },
        "apiKeyEnvVar": { "type": "string", "minLength": 1 }
      },
      "required": ["provider", "model", "apiKeyFromRuntimeSecret", "apiKeyEnvVar"]
    },
    "documentsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "minLength": 1 },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dsn": { "type": "string" },
            "maxConns": { "type": "integer", "minimum": 1 }
          },
          "required": ["dsn", "maxConns"]
        },
        "garage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string" },
            "region": { "type": "string" },
            "bucket": { "type": "string" },
            "accessKeyId": { "type": "string" },
            "secretAccessKey": { "type": "string" },
            "forcePathStyle": { "type": "boolean" }
          },
          "required": ["endpoint", "region", "bucket", "accessKeyId", "secretAccessKey", "forcePathStyle"]
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backfillOnStartup": { "type": "boolean" },
            "readThroughOnMiss": { "type": "boolean" },
            "mergeListFallback": { "type": "boolean" },
            "dualWriteEtcd": { "type": "boolean" }
          },
          "required": ["backfillOnStartup", "readThroughOnMiss", "mergeListFallback", "dualWriteEtcd"]
        },
        "watchPollInterval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        }
      },
      "required": ["backend", "postgres", "garage", "migration", "watchPollInterval"]
    },
    "documentDependencyImage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "tag", "pullPolicy"]
    },
    "documentDependenciesConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "$ref": "#/definitions/documentDependencyImage" },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              },
              "required": ["port"]
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "database": { "type": "string", "minLength": 1 },
                "username": { "type": "string", "minLength": 1 }
              },
              "required": ["database", "username"]
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "storageClassName": { "type": "string" },
                "size": { "type": "string", "minLength": 1 }
              },
              "required": ["storageClassName", "size"]
            },
            "resources": { "$ref": "#/definitions/resourceRequirements" }
          },
          "required": ["enabled", "image", "service", "auth", "persistence", "resources"]
        },
        "garage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "$ref": "#/definitions/documentDependencyImage" },
            "service": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "s3Port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "rpcPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "adminPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
              },
              "required": ["s3Port", "rpcPort", "adminPort"]
            },
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "replicationFactor": { "type": "integer", "minimum": 1 },
                "dbEngine": { "type": "string", "minLength": 1 },
                "rpcSecret": { "type": "string", "minLength": 1 },
                "adminToken": { "type": "string", "minLength": 1 },
                "metricsToken": { "type": "string", "minLength": 1 },
                "region": { "type": "string", "minLength": 1 },
                "bucket": { "type": "string", "minLength": 1 }
              },
              "required": [
                "replicationFactor",
                "dbEngine",
                "rpcSecret",
                "adminToken",
                "metricsToken",
                "region",
                "bucket"
              ]
            },
            "bootstrap": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "keyName": { "type": "string", "minLength": 1 },
                "zone": { "type": "string", "minLength": 1 },
                "capacity": { "type": "string", "minLength": 1 },
                "waitTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
                "image": { "$ref": "#/definitions/documentDependencyImage" }
              },
              "required": ["enabled", "keyName", "zone", "capacity", "waitTimeout", "image"]
            },
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "storageClassName": { "type": "string" },
                "size": { "type": "string", "minLength": 1 }
              },
              "required": ["storageClassName", "size"]
            },
            "resources": { "$ref": "#/definitions/resourceRequirements" }
          },
          "required": ["enabled", "image", "service", "config", "bootstrap", "persistence", "resources"]
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": { "type": "string" },
            "create": { "type": "boolean" },
            "managed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "postgresPassword": { "type": "string" },
                "postgresDsn": { "type": "string" },
                "garageAccessKeyId": { "type": "string" },
                "garageSecretAccessKey": { "type": "string" }
              },
              "required": ["postgresPassword", "postgresDsn", "garageAccessKeyId", "garageSecretAccessKey"]
            },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "postgresPassword": { "type": "string", "minLength": 1 },
                "postgresDsn": { "type": "string", "minLength": 1 },
                "garageAccessKeyId": { "type": "string", "minLength": 1 },
                "garageSecretAccessKey": { "type": "string", "minLength": 1 }
              },
              "required": ["postgresPassword", "postgresDsn", "garageAccessKeyId", "garageSecretAccessKey"]
            }
          },
          "required": ["existingSecret", "create", "managed", "keys"]
        }
      },
      "required": ["postgres", "garage", "credentials"]
    },
    "resourceRequirements": {
      "type": "object"
    },
    "loopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "backoffInitial": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "backoffMax": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "terminateOnError": { "type": "boolean" }
      },
      "required": ["maxAttempts", "backoffInitial", "backoffMax", "timeout", "terminateOnError"]
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "targetMemoryUtilizationPercentage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "scaleUpStabilizationWindowSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "scaleDownStabilizationWindowSeconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "targetMemoryUtilizationPercentage",
        "scaleUpStabilizationWindowSeconds",
        "scaleDownStabilizationWindowSeconds"
      ]
    },
    "replicaTemplate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceAccountName": { "type": "string" },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        },
        "env": {
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        }
      },
      "required": ["serviceAccountName", "resources", "nodeSelector", "tolerations", "env"]
    },
    "componentConfigWithLoopPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "image": { "$ref": "#/definitions/componentImage" },
        "replicaImage": { "$ref": "#/definitions/componentImage" },
        "workspaceSeedImage": { "$ref": "#/definitions/optionalComponentImage" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
        "loopPolicy": { "$ref": "#/definitions/loopPolicy" },
        "replicaTemplate": { "$ref": "#/definitions/replicaTemplate" },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "env": {
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        }
      },
      "required": ["enabled", "replicaCount", "autoscaling", "image", "replicaImage", "serviceAccount", "loopPolicy", "replicaTemplate", "resources", "env"]
    },
    "componentConfigWithService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiBaseUrl": { "type": "string", "minLength": 1 },
        "chatBaseUrl": { "type": "string", "minLength": 1 },
        "operatorPermissions": { "type": "string" },
        "featureCapabilityAccess": { "type": "boolean" },
        "featureFlags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tasks": { "type": "boolean" },
            "tasksKanban": { "type": "boolean" },
            "featureCapability": { "type": "boolean" },
            "chat": { "type": "boolean" },
            "integrations": { "type": "boolean" },
            "secrets": { "type": "boolean" },
            "providerClaude": { "type": "boolean" },
            "providerClaudeMax": { "type": "boolean" },
            "providerGemini": { "type": "boolean" },
            "prdDiagnosticResolve": { "type": "boolean" }
          },
          "required": ["tasks", "featureCapability"]
        },
        "showComingSoonProviders": { "type": "boolean" },
        "goose": { "$ref": "#/definitions/gooseConfig" },
        "documents": { "$ref": "#/definitions/documentsConfig" },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": { "$ref": "#/definitions/autoscaling" },
        "image": { "$ref": "#/definitions/componentImage" },
        "service": { "$ref": "#/definitions/service" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "env": {
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        }
      },
      "required": ["enabled", "replicaCount", "autoscaling", "image", "service", "serviceAccount", "resources", "env"]
    },
    "daemonCleanupRetention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flatline": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "cancelled": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "synced": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        }
      },
      "required": ["flatline", "cancelled", "synced"]
    },
    "daemonCleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "timeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h)$"
        },
        "dryRun": { "type": "boolean" },
        "maxDeletes": {
          "type": "integer",
          "minimum": 0
        },
        "retention": { "$ref": "#/definitions/daemonCleanupRetention" }
      },
      "required": ["interval", "timeout", "dryRun", "maxDeletes", "retention"]
    },
    "daemonConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "image": { "$ref": "#/definitions/componentImage" },
        "serviceAccount": { "$ref": "#/definitions/serviceAccount" },
        "cleanup": { "$ref": "#/definitions/daemonCleanup" },
        "resources": { "$ref": "#/definitions/resourceRequirements" },
        "env": {
          "type": "array",
          "items": { "$ref": "#/definitions/envVar" }
        }
      },
      "required": ["enabled", "replicaCount", "image", "serviceAccount", "cleanup", "resources", "env"]
    }
  }
}
